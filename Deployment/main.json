{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "1238309395858586296"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "地域でFreeプランとSQL無料オファーを利用できることを公開前に確認する。"
      }
    },
    "appName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40
    },
    "sqlServerName": {
      "type": "string"
    },
    "databaseName": {
      "type": "string",
      "defaultValue": "coastracer"
    },
    "sqlAdminName": {
      "type": "string"
    },
    "sqlAdminObjectId": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-free', parameters('appName'))]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "F1",
        "tier": "Free",
        "capacity": 1
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-free', parameters('appName')))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|10.0",
          "appCommandLine": "dotnet CoastRacer.Server.dll",
          "alwaysOn": false,
          "webSocketsEnabled": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "Racer__MaxPlayers",
              "value": "2"
            },
            {
              "name": "ConnectionStrings__RacerSql",
              "value": "[format('Server=tcp:{0}.{1},1433;Database={2};Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;Pooling=False;Connect Timeout=10;ConnectRetryCount=0;', parameters('sqlServerName'), environment().suffixes.sqlServerHostname, parameters('databaseName'))]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-free', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[parameters('sqlServerName')]",
      "location": "[parameters('location')]",
      "properties": {
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled",
        "administrators": {
          "administratorType": "ActiveDirectory",
          "login": "[parameters('sqlAdminName')]",
          "sid": "[parameters('sqlAdminObjectId')]",
          "tenantId": "[subscription().tenantId]",
          "azureADOnlyAuthentication": true
        }
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', parameters('sqlServerName'), parameters('databaseName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "GP_S_Gen5",
        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 2
      },
      "properties": {
        "useFreeLimit": true,
        "freeLimitExhaustionBehavior": "AutoPause",
        "autoPauseDelay": 60,
        "minCapacity": "[json('0.5')]",
        "maxSizeBytes": 34359738368,
        "zoneRedundant": false,
        "requestedBackupStorageRedundancy": "Local"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('sqlServerName'))]"
      ]
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName)]"
    },
    "managedIdentityObjectId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01', 'full').identity.principalId]"
    },
    "outboundAddresses": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').outboundIpAddresses]"
    },
    "sqlHost": {
      "type": "string",
      "value": "[format('{0}.{1}', parameters('sqlServerName'), environment().suffixes.sqlServerHostname)]"
    }
  }
}